    "content:import": "node scripts/import-content.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "katex": "0.16.22",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "supabase": "3.0.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
