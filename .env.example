# --- Front (Vite) : exposées au navigateur, donc uniquement des valeurs publiques ---
# Supabase > Project Settings > API (ou Connect)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# Clé publishable (sb_publishable_...). Jamais la clé secrète ici.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Domaine des e-mails factices fabriqués à partir du pseudo (doit être identique
# à private.app_config.fake_email_domain en base)
VITE_FAKE_EMAIL_DOMAIN=promo.invalid

# --- Scripts locaux (import CSV) : NE JAMAIS préfixer par VITE_ ---
# Supabase > Project Settings > API Keys > Secret keys (sb_secret_...)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx
